# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Database name (optional, defaults to "pitchcraft")
MONGODB_DB=pitchcraft

# ── Tier 1 — Google Gemini (primary, default) ─────────────────────────────
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.1-flash-lite

# ── Tier 2 — Llama 3.3 70B Instruct Free via OpenRouter (auto-fallback) ───
# https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# ── Tier 3 — DeepSeek V4 Flash via NVIDIA ─────────────────────────────────
# https://build.nvidia.com
NVIDIA_API_KEY_DEEPSEEK=nvapi-...

# ── Tier 4 — MiniMax M2.7 via NVIDIA ──────────────────────────────────────
NVIDIA_API_KEY_MINIMAX=nvapi-...

# Port for `python main.py` (optional, defaults to 8000)
PORT=8000
