# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority

# Database name (optional, defaults to "pitchcraft")
MONGODB_DB=pitchcraft

# Google Gemini API key — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your-gemini-api-key

# Gemini model — use the API model ID, not the AI Studio display name.
# "Gemini 3.1 Flash-Lite" -> gemini-3.1-flash-lite (optional; this is the default).
# If that ID isn't available on your key, fall back to gemini-2.0-flash-lite or gemini-1.5-flash.
GEMINI_MODEL=gemini-3.1-flash-lite

# Port for `python main.py` (optional, defaults to 8000)
PORT=8000
