# ── MongoDB Atlas ───────────────────────────────────────────────────────────
# Atlas cluster connection string. Add 0.0.0.0/0 in Atlas → Network Access so
# the agent (local + Cloud Run) can connect.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=ticketguard

# ── Gemini backend ───────────────────────────────────────────────────────────
# DEV (fast): Google AI Studio key. https://aistudio.google.com/app/apikey
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=your-ai-studio-key

# ── API-key rotation (optional but strongly recommended for demos) ────────────
# On a 429 / RESOURCE_EXHAUSTED the backend rotates to the next available key
# so investigations keep running even when one key's free-tier quota is spent.
# Create additional keys at aistudio.google.com (each has its own quota bucket).
# Leave blank / unset if you only have one key — the app degrades gracefully.
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

# SUBMISSION (required for the hackathon): Vertex AI on Google Cloud.
# Flip the flag and set the project — no code change needed.
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# Verified-available GA model (do not use gemini-3.x / 1.5 / 2.0).
GEMINI_MODEL=gemini-2.5-flash
EMBED_MODEL=text-embedding-004
EMBED_DIMS=768

# ── Multi-model (Gemini-only) ────────────────────────────────────────────────
# TicketGuard registers ONLY Gemini variants (hackathon rule: core AI = Gemini).
# Pick a model per request via the "model" field; the pipeline auto-falls-back
# across these tiers when the primary is rate-limited (each tier has its own
# free-tier quota bucket). Any NON-Gemini id listed here is IGNORED by
# models_registry — a compliance guardrail.
MODEL_FALLBACK_ORDER=gemini-2.5-flash,gemini-2.5-flash-lite,gemini-2.5-pro

# ── Arize Phoenix — AI observability (free at app.phoenix.arize.com) ─────────
# Optional. When PHOENIX_API_KEY is set, every Gemini call + each of the 8
# investigation steps + the Atlas hybrid-search are traced to Phoenix. Unset →
# tracing is silently disabled (the app runs exactly as before).
PHOENIX_API_KEY=px-your-key-here
PHOENIX_BASE_URL=https://app.phoenix.arize.com
PHOENIX_PROJECT=ticketguard

# ── Trust & Safety email (optional) ─────────────────────────────────────────
# When set, the Verdict Writer emails a formal threat-intel report to the T&S
# inbox whenever it returns a SCAM verdict with confidence ≥ 0.75.
# Works with any SMTP provider. For Gmail: enable 2FA and create an App Password at
# https://myaccount.google.com/apppasswords — use that as SMTP_PASSWORD.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-sender@gmail.com
SMTP_PASSWORD=your-app-password
# Destination inbox — defaults to trust@ticketguard.ai if unset.
TRUST_SAFETY_EMAIL=trust@ticketguard.ai

# ── Web search — seller reputation (optional) ────────────────────────────────
# When set, the Verdict Writer searches Reddit, Twitter/X, Trustpilot, and scam-
# reporting forums for community reports about the seller before issuing a verdict.
# Provide ONE of: Tavily (preferred, broader web) or Brave Search.
#
# Tavily: https://app.tavily.com  (free tier: 1 000 searches/month)
TAVILY_API_KEY=
# Brave Search: https://brave.com/search/api/  (free tier: 2 000 queries/month)
BRAVE_SEARCH_API_KEY=

# ── Discord moderation webhook (optional) ────────────────────────────────────
# When set, the Verdict Writer agent fires a "🚨 TICKETGUARD BAN ENACTED" embed
# to this webhook channel whenever it returns a SCAM verdict with confidence ≥ 0.75.
# Create a webhook in Discord: Server Settings → Integrations → Webhooks → New.
# Leave blank to disable alerts (the SCAM verdict still works without it).
DISCORD_WEBHOOK_URL=

# ── Server ───────────────────────────────────────────────────────────────────
PORT=8000
# Comma-separated allowed origins for CORS (defaults to * if unset).
# CORS_ORIGINS=https://your-frontend.vercel.app
