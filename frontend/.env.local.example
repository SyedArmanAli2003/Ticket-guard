# ─────────────────────────────────────────────────────────────────────────────
# TicketGuard frontend — runtime mode is decided by these public env vars.
#
#   REAL mode  → set NEXT_PUBLIC_API_URL to the deployed backend (Cloud Run).
#                The app calls the real SSE investigate / health / report / feed.
#   MOCK mode  → leave NEXT_PUBLIC_API_URL unset and set NEXT_PUBLIC_DEMO=mock.
#                The app runs the self-contained synthetic engine and shows a
#                visible "DEMO — no live backend" badge. (Used by the Vercel
#                preview.)
#   UNCONFIGURED → neither set in a production build → the app shows an explicit
#                "Not configured" state and never silently mocks a verdict.
#
# Local `next dev` proxies /api/* → http://localhost:8001 (see next.config.mjs),
# so in development the app defaults to REAL against your local backend without
# needing NEXT_PUBLIC_API_URL. Set NEXT_PUBLIC_DEMO=mock to force the demo in dev.
# ─────────────────────────────────────────────────────────────────────────────

# REAL mode (production): URL of the deployed backend.
NEXT_PUBLIC_API_URL=https://your-backend-xxxxx-uc.a.run.app

# MOCK mode (deployed preview with no backend): uncomment and remove the URL above.
# NEXT_PUBLIC_DEMO=mock
